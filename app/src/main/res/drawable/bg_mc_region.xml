<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/mc_primary" />
            <stroke android:width="1.2dp" android:color="@color/mc_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/mc_background" />
            <stroke android:width="1.2dp" android:color="@color/mc_region_border" />
        </shape>
    </item>
</selector>
