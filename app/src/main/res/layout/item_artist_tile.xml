<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/tile_body" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_mc_tile" android:foreground="@drawable/bg_mc_tile_border">
    <edu.taehyeon.myconcert.ArtistAvatarView android:id="@+id/tile_portrait" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="90dp" android:layout_gravity="bottom" android:background="@drawable/bg_mc_tile_gradient" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/check_plate" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_mc_check_plate">
        <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/tile_check" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" app:buttonTint="@color/mc_check" />
    </FrameLayout>
    <TextView android:id="@+id/tile_selected" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Mc.Text" android:text="@string/ui_item_artist_tile_tile_selected_text" android:layout_gravity="top|start" android:layout_marginTop="16dp" android:layout_marginStart="10dp" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/bg_mc_selected" android:importantForAccessibility="no" android:paddingStart="8dp" android:paddingEnd="8dp" />
    <TextView android:id="@+id/tile_name" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Mc.Text" android:text="" android:layout_gravity="bottom|end" android:layout_marginBottom="10dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:minHeight="32dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:lineSpacingExtra="2dp" android:background="@drawable/bg_mc_name" android:importantForAccessibility="no" tools:text="아이브" android:paddingStart="12dp" android:paddingEnd="12dp" />
</FrameLayout>