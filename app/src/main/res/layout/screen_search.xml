<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <TextView android:id="@+id/search_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Muted" android:text="@string/ui_screen_search_search_subtitle_text" />
    <include android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" layout="@layout/view_search_input" />
    <TextView android:id="@+id/search_hint" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Caption" android:text="@string/ui_screen_search_search_hint_text" android:layout_marginTop="12dp" />
    <LinearLayout android:id="@+id/search_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="28dp" />
</LinearLayout>