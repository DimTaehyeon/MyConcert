<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/screen_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <LinearLayout android:id="@+id/artist_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/artist_bio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp" android:baselineAligned="false">
            <edu.taehyeon.myconcert.ArtistAvatarView android:id="@+id/artist_avatar" android:layout_width="52dp" android:layout_height="52dp" />
            <LinearLayout android:id="@+id/bio_text" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
                <TextView android:id="@+id/artist_kind" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Muted" android:text="" tools:text="엔믹스 · 그룹" />
                <TextView android:id="@+id/artist_search_basis" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Caption" android:text="" android:layout_marginTop="6dp" tools:text="공식명·출연진으로 확인한 공연" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/favorite_button" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/bg_mc_favorite" app:tint="@color/mc_accent" />
        </LinearLayout>
        <TextView android:id="@+id/profile_source" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Action" android:text="@string/ui_screen_artist_profile_source_text" />
        <TextView android:id="@+id/artist_aliases" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Button" android:text="" tools:text="검색 표기 · NMIXX / 엔믹스" />
        <include android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" layout="@layout/view_tabs" />
    </LinearLayout>
    <LinearLayout android:id="@+id/range_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:baselineAligned="false">
        <TextView android:id="@+id/range_label" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Mc.Text.Caption" android:text="@string/ui_screen_artist_range_label_text" android:layout_weight="1" android:textSize="13sp" />
        <TextView android:id="@+id/range_select" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Mc.Text.Action" android:text="" tools:text="각 30일 ⌄" />
    </LinearLayout>
    <LinearLayout android:id="@+id/expanded_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <CheckBox android:id="@+id/expanded_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_screen_artist_expanded_search_text" android:textSize="13sp" android:textColor="@color/mc_muted" app:buttonTint="@color/mc_accent" />
        <TextView android:id="@+id/expanded_hint" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Mc.Text.Caption" android:text="@string/ui_screen_artist_expanded_hint_text" android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/data_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" />
</LinearLayout>