<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp" android:baselineAligned="false">
    <FrameLayout android:id="@+id/back_button" android:layout_width="36dp" android:layout_height="48dp" style="@style/Mc.IconButton" android:contentDescription="@string/ui_view_toolbar_back_button_contentdescription">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" style="@style/Mc.Icon" android:src="@drawable/ic_back" android:layout_gravity="center" app:tint="@color/mc_muted" android:contentDescription="@null" />
